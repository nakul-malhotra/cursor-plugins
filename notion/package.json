{
  "name": "notion-workspace-plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "package:local": "npm run build --silent && node scripts/assemble.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "npm run build --silent && node --test dist/test/*.test.js",
    "test:integration": "npm run build --silent && node --test dist/test/integration/*.test.js",
    "test:e2e": "npm run build --silent && node --test dist/test/e2e/*.test.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0"
  }
}
